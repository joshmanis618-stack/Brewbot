# Copy this file to .env and fill in your own values before running docker compose.
# .env is gitignored and must never be committed.

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-with-a-random-64-char-hex-string

# PostgreSQL credentials — used by both the db service and the api service.
# If you change these after the database volume already exists you must also
# update the password inside Postgres:
#   docker compose exec db psql -U <old_user> -c "ALTER USER <user> PASSWORD '<new_password>';"
POSTGRES_USER=brewbot
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=brewbot
